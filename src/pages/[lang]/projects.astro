---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionBlock from "../../components/SectionBlock";
import ProjectCard from "../../components/ProjectCard";
import { useTranslations } from "../../i18n/utils";

export function getStaticPaths() {
  return [
    { params: { lang: "zh-CN" } },
    { params: { lang: "zh-TW" } },
    { params: { lang: "en" } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang);

const projects = [
  {
    id: "aurora",
    title: "Aurora UI",
    tags: ["React", "TypeScript", "Storybook"],
    url: "https://github.com/rover0",
    image:
      "https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=600&h=300&fit=crop",
  },
  {
    id: "veloci",
    title: "VeloCI",
    tags: ["Go", "CLI", "DevOps"],
    url: "https://github.com/rover0",
    image:
      "https://images.unsplash.com/photo-1629654297299-c8506221ca97?w=600&h=300&fit=crop",
  },
  {
    id: "pixelflow",
    title: "PixelFlow",
    tags: ["WebGL", "Canvas", "WASM"],
    url: "https://github.com/rover0",
    image:
      "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=600&h=300&fit=crop",
  },
  {
    id: "nexflow",
    title: "NexFlow",
    tags: ["React Flow", "Node.js", "Docker"],
    url: "https://github.com/rover0",
    image:
      "https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=600&h=300&fit=crop",
  },
  {
    id: "tinymark",
    title: "TinyMark",
    tags: ["Vanilla JS", "Markdown", "Plugin"],
    url: "https://github.com/rover0",
    image:
      "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&h=300&fit=crop",
  },
  {
    id: "skymetrics",
    title: "SkyMetrics",
    tags: ["TypeScript", "ClickHouse", "Grafana"],
    url: "https://github.com/rover0",
    image:
      "https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=600&h=300&fit=crop",
  },
];
---

<BaseLayout
  lang={lang}
  title={`${t("projects.title")} — Rover`}
  description="Rover 的开源项目和作品集。"
>
  <section class="pt-32 pb-20">
    <div class="max-w-6xl mx-auto px-6">
      <!-- Header -->
      <SectionBlock client:visible>
        <div class="text-center mb-16">
          <h1
            class="text-4xl md:text-5xl font-bold font-[family-name:var(--font-display)] text-[var(--color-text-primary)] mb-4"
          >
            {t("projects.title")}
          </h1>
          <p
            class="text-lg text-[var(--color-text-secondary)] max-w-2xl mx-auto"
          >
            {t("projects.subtitle")}
          </p>
          <div
            class="w-20 h-1 bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-purple)] rounded-full mx-auto mt-6"
          >
          </div>
        </div>
      </SectionBlock>

      <!-- Project grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          projects.map((project, i) => (
            <ProjectCard
              title={project.title}
              description={t(`project.${project.id}.desc` as any)}
              tags={project.tags}
              url={project.url}
              image={project.image}
              index={i}
              client:visible
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
